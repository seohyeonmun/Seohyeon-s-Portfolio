rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidGuestbookEntry(data) {
      return data.keys().hasAll(['name', 'message', 'date', 'createdAt']) &&
             data.keys().size() == 4 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 5000 &&
             data.date is string && data.date.size() <= 20 &&
             data.createdAt == request.time;
    }

    match /guestbook/{entryId} {
      allow read: if true;
      allow create: if isValidGuestbookEntry(incoming());
      allow delete: if true;
    }
  }
}
